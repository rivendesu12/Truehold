# Production template for truehold.co.uk / truehold.yaenlinea.co
# Copy to .env on the server and fill the two secrets. NEVER commit the real .env.

APP_NAME=Truehold
APP_ENV=production
APP_KEY=                      # php artisan key:generate
APP_DEBUG=false
APP_URL=https://truehold.yaenlinea.co

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# SQLite is sufficient: property listings come from the HarborOps API and the
# CRM tables are unused. Switch to mysql only if the legacy CRM data is imported.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/truehold/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Secrets: fill these in, do not commit ---
HARBOROPS_API_URL=https://truehold.harborops.co.uk
HARBOROPS_API_KEY=            # from the HarborOps tenant
HARBOROPS_CACHE_TIMEOUT=300

GOOGLE_MAPS_API_KEY=          # restrict to the site domain in Google Cloud

# Mail is not used by the public listings site. Configure only if agent
# password resets are needed.
MAIL_MAILER=log
