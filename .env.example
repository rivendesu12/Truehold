APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# Session idle timeout in minutes (default 525600 = 1 year). Stays logged in until logout or cookies cleared.
SESSION_LIFETIME=525600
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Harbor Ops scraped-listings API (main property feed)
# Public API key issued in-app (Settings -> API Keys), needs scraped_listings:read scope
# HARBOROPS_API_URL=https://yourslug.harborops.co.uk
# HARBOROPS_API_KEY=your_public_api_key
# HARBOROPS_CACHE_TIMEOUT=300
# HARBOROPS_PORTAL_DOMAIN=harborops.co.uk

# Google Sheets (legacy properties feed - used only when Harbor Ops is not configured)
# GOOGLE_PROPERTIES_SPREADSHEET_ID=your_spreadsheet_id
# GOOGLE_PROPERTIES_SHEET_NAME=Properties
# GOOGLE_PROPERTIES_CREDENTIALS_PATH=google-credentials.json
# Path is relative to storage/app (e.g. google-credentials.json) or absolute

# Optional. TfL open data works without a key at ~50 requests/minute, which is
# all the site needs at runtime. A free key raises it to 500/minute and only
# speeds up transport:build-journeys (hours to minutes).
TFL_APP_KEY=

# The assistant only needs an OpenAI-compatible /chat/completions endpoint
# with strict JSON-schema output. Point this elsewhere to use another
# provider without touching code.
OPENAI_BASE_URL=https://api.openai.com/v1

# Office WiFi that Sigou gives agents (values only in the real .env)
OFFICE_WIFI_SSID=
OFFICE_WIFI_PASSWORD=
OFFICE_WIFI_QR_URL=
